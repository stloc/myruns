{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyRuns",
  "version": "0.1.0",
  "identifier": "local.myruns.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Suivi de course à pied et prédiction d'objectif",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../build/app/": "app/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDNjVDRDYyRTBEQUI3QzUKUldURnQ5cmdZczFsVEs1TGhYZGw5by9kbkNqSG5hc3FtZFAvMzk3RlNvbUx3cTdPR0oxc2F5K3kK",
      "endpoints": [
        "https://github.com/stloc/myruns/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
