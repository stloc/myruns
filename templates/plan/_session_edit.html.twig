{# Réécriture d'une séance à venir (contenu donné le jour même par le club, par exemple). #}
<details class="session-edit">
    <summary>Modifier</summary>
    <form method="post" action="{{ path('plan_session', {week: week_id, day: weekday}) }}" class="session-edit-form">
        <input type="hidden" name="_token" value="{{ token }}">
        <label>Type
            <select name="type">
                {% for type in session_types %}
                    <option value="{{ type.value }}" {% if type == session.type %}selected{% endif %}>{{ type.label }}</option>
                {% endfor %}
            </select>
        </label>
        <label>Contenu
            <textarea name="description" rows="3" maxlength="500" required>{{ session.description }}</textarea>
        </label>
        <label>Distance (km)
            <input type="number" name="km" value="{{ session.distanceKm }}" min="0.5" max="100" step="0.1" required>
        </label>
        <div class="form-actions">
            <button type="submit" class="button button-secondary">Enregistrer</button>
            {% if session.edited %}
                <button type="submit" name="action" value="reset" class="link-button" formnovalidate>Revenir à la séance prévue</button>
            {% endif %}
        </div>
    </form>
</details>
