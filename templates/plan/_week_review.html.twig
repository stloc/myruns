{% import 'plan/_macros.html.twig' as plan %}
{% set weekdays = ['lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.', 'dim.'] %}
{# movable : jours (1-7) qui peuvent changer de séance ; absent, la semaine est en lecture seule (sans les jours de repos). #}
{% set movable = movable ?? null %}
{% if review.advice %}<p class="alert alert-warning">{{ review.advice }}</p>{% endif %}
<div class="table-scroll">
    <table class="data-table plan-review-table">
        <thead>
            <tr>
                <th scope="col">Jour</th>
                <th scope="col">Séance</th>
                <th scope="col">Contenu</th>
                <th scope="col" class="num">Prévu</th>
                <th scope="col" class="num">Réalisé</th>
                <th scope="col">Bilan</th>
            </tr>
        </thead>
        <tbody>
            {% for weekday in 1..7 %}
                {% set session_review = review.sessionOn(weekday) %}
                {% if session_review %}
                {% set session = session_review.session %}
                {% set day = session_review.date %}
                <tr {{ plan.day_attributes(weekday, weekday in movable) }}>
                    <td {{ plan.handle_attributes(weekday in movable) }}>{{ weekdays[day|date('N') - 1] }} {{ day|date('d/m') }}</td>
                    <td>{{ session.type.label }}{% if session.edited %} <span class="badge">modifiée</span>{% endif %}</td>
                    <td>
                        {{ session.description }}
                        {% if weekday in movable %}
                            {{ include('plan/_session_edit.html.twig', {week_id: week_id, weekday: weekday, session: session, session_types: session_types, token: token}, with_context = false) }}
                        {% endif %}
                    </td>
                    <td class="num">{{ session.distanceKm|number_format(1, ',') }} km</td>
                    <td class="num">
                        {% for run in session_review.activities %}
                            <a href="{{ path('activity_show', {id: run.id}) }}">{{ (run.distanceMeters / 1000)|number_format(1, ',') }} km</a>
                            <span class="muted">{{ run.paceSecondsPerKm|pace }}</span>{% if not loop.last %}<br>{% endif %}
                        {% else %}
                            <span class="muted">–</span>
                        {% endfor %}
                    </td>
                    <td class="plan-review-outcome">{{ include('plan/_session_outcome.html.twig', {review: session_review}, with_context = false) }}</td>
                </tr>
                {% elseif movable is not null %}
                {% set day = review.week.monday.modify('+' ~ (weekday - 1) ~ ' days') %}
                <tr class="plan-rest" {{ plan.day_attributes(weekday, weekday in movable) }}>
                    <td>{{ weekdays[weekday - 1] }} {{ day|date('d/m') }}</td>
                    <td colspan="5" class="muted">Repos</td>
                </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>
</div>
{% if review.extras is not empty %}
    <p class="card-subtitle plan-review-extras">
        Hors programme :
        {% for run in review.extras %}
            <a href="{{ path('activity_show', {id: run.id}) }}">{{ weekdays[run.startDate|date('N') - 1] }} {{ run.startDate|date('d/m') }} · {{ (run.distanceMeters / 1000)|number_format(1, ',') }} km</a>{% if not loop.last %}, {% endif %}
        {% endfor %}
    </p>
{% endif %}
