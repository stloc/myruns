{% extends 'base.html.twig' %}

{% block title %}Programme d'entraînement{% endblock %}

{% block head %}
    {# Échange de jours : la page revient à la même adresse et Turbo la rafraîchit sur place. #}
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
{% endblock %}

{% block body %}
    {% import 'plan/_macros.html.twig' as plan_macros %}
    {% set weekdays = ['lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.', 'dim.'] %}
    <div class="page-heading">
        <h1>Programme d'entraînement</h1>
    </div>

    {% if not goal %}
        <section class="card empty-state">
            <h2>Aucun objectif enregistré</h2>
            <p>Le programme se construit à partir de votre objectif : distance, temps visé et date.</p>
            <a class="button" href="{{ path('goal') }}">Saisir un objectif</a>
        </section>
    {% elseif not plan %}
        <section class="card empty-state">
            <h2>Objectif passé</h2>
            <p>La date de votre dernier objectif ({{ goal.describe }}) est dépassée.</p>
            <a class="button" href="{{ path('goal') }}">Choisir un nouvel objectif</a>
        </section>
    {% else %}
        <p class="intro">Objectif : <strong>{{ goal.describe }}</strong> · <a href="{{ path('goal') }}">modifier</a></p>

        <section class="card plan-review">
            <h2>Bilan et conseils</h2>
            {% if review.probabilityPercent is not null %}
                {% set change = review.probabilityChange %}
                <p>
                    Probabilité de réussir l'objectif : <strong>{{ review.probabilityPercent }} %</strong>
                    {%- if change %} ({{ change > 0 ? '+' }}{{ change }} pt{{ change|abs > 1 ? 's' }} depuis lundi){% endif %}.
                </p>
            {% endif %}
            {% if review.changes is not empty %}
                <p class="card-subtitle">Vos sorties depuis lundi ont fait évoluer le programme :</p>
                <ul class="factors">
                    {% for change in review.changes %}
                        <li>{{ change }}</li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="muted">Programme inchangé depuis lundi.</p>
            {% endif %}
            {% set last = review.latestDone %}
            {% if last %}
                <h3>Dernière séance : {{ last.session.type.label|lower }} du {{ last.date|date('d/m') }}</h3>
                <p class="plan-review-outcome">{{ include('plan/_session_outcome.html.twig', {review: last}, with_context = false) }}</p>
            {% endif %}
            <p class="card-subtitle">La semaine en cours reste celle prévue lundi ; les semaines suivantes suivent votre forme du jour.</p>
        </section>

        {% if review.previousWeek %}
            {% set previous = review.previousWeek %}
            <section class="card" id="semaine-passee">
                <h2>Semaine passée</h2>
                <p class="card-subtitle">
                    {{ previous.week.monday|date('d/m') }} → {{ previous.week.sunday|date('d/m') }} ·
                    {{ previous.succeededCount }} séance(s) réussie(s) sur {{ previous.sessions|length }} ·
                    {{ previous.doneKm|number_format(1, ',') }} km sur {{ previous.week.volumeKm|number_format(1, ',') }} prévus
                </p>
                {{ include('plan/_week_review.html.twig', {review: previous}, with_context = false) }}
            </section>
        {% endif %}

        <section class="card">
            <h2>Réglages</h2>
            {{ form_start(settings_form, {attr: {class: 'form plan-settings'}}) }}
                <div class="plan-settings-fields">
                    {{ form_row(settings_form.planSessionsPerWeek) }}
                </div>
                <div class="form-actions">
                    <button type="submit" class="button">Enregistrer</button>
                </div>
            {{ form_end(settings_form) }}
        </section>

        <div class="stat-grid">
            <div class="stat-tile">
                <span class="stat-label">Semaines</span>
                <span class="stat-value">{{ plan.weeks|length }}</span>
                <span class="stat-detail">jusqu'au {{ goal.date|date('d/m/Y') }}</span>
            </div>
            <div class="stat-tile">
                <span class="stat-label">Volume au pic</span>
                <span class="stat-value">{{ plan.peakVolumeKm|number_format(0, ',') }} km</span>
                <span class="stat-detail">par semaine</span>
            </div>
            <div class="stat-tile">
                <span class="stat-label">Sortie longue max</span>
                <span class="stat-value">{{ plan.longestRunKm|number_format(1, ',') }} km</span>
            </div>
        </div>

        <div class="grid-2">
            <section class="card">
                <h2>Vos allures</h2>
                <dl class="key-values">
                    <dt>Footing</dt>
                    <dd>{{ plan.paces.easyFast|duration }}–{{ plan.paces.easySlow|duration }}/km</dd>
                    <dt>Sortie longue</dt>
                    <dd>{{ plan.paces.easySlow|pace }}</dd>
                    <dt>Marathon</dt>
                    <dd>{{ plan.paces.marathon|pace }}</dd>
                    <dt>Seuil</dt>
                    <dd>{{ plan.paces.threshold|pace }}</dd>
                    <dt>VMA</dt>
                    <dd>{{ plan.paces.interval|pace }}</dd>
                    <dt>Allure objectif</dt>
                    <dd><strong>{{ plan.paces.goal|pace }}</strong></dd>
                </dl>
            </section>

            <section class="card">
                <h2>À savoir</h2>
                <ul class="factors">
                    {% for note in plan.notes %}
                        <li>{{ note }}</li>
                    {% endfor %}
                    <li>Une semaine allégée toutes les quatre pour assimiler le travail.</li>
                    <li>Les jours sont indicatifs : glissez une séance (par son jour) sur un autre jour pour les échanger, en évitant deux séances intenses d'affilée.</li>
                    <li>Une semaine différente (sortie en plus ou en moins) : ajustez-la dans la semaine concernée.</li>
                    <li>Contenu connu le jour même (séance de club, fractionné imposé) : « Modifier » sous la séance, le bilan la jugera sur ce que vous avez saisi.</li>
                </ul>
            </section>
        </div>

        {% for week in plan.weeks %}
            {% set current = week.contains(today) %}
            {% set week_id = week.monday|date('Y-m-d') %}
            {% set first_week = loop.first %}
            {% set week_token = csrf_token('plan_week_' ~ week_id) %}
            {# Jours à venir dont la séance peut changer : jamais l'objectif ni une séance déjà courue. #}
            {% set movable = [] %}
            {% for weekday in 1..7 %}
                {% set session = week.sessionOn(weekday) %}
                {% set session_review = first_week ? review.currentWeek.sessionOn(weekday) : null %}
                {% if week.monday.modify('+' ~ (weekday - 1) ~ ' days') >= today
                    and (session is null or session.type.value != 'race')
                    and (session_review is null or session_review.outcome.value == 'upcoming') %}
                    {% set movable = movable|merge([weekday]) %}
                {% endif %}
            {% endfor %}
            <details class="card plan-week" id="semaine-{{ week_id }}" {% if current %}open{% endif %}
                     data-controller="plan-week" data-action="turbo:before-morph-attribute->plan-week#keepOpen">
                <summary>
                    <span class="plan-week-title">Semaine {{ week.number }}</span>
                    <span class="muted">{{ week.monday|date('d/m') }} → {{ week.sunday|date('d/m') }}</span>
                    <span>{{ week.phase.label }}</span>
                    {% if week.recovery %}<span class="badge">allégée</span>{% endif %}
                    {% if week.adjusted %}<span class="badge">ajustée</span>{% endif %}
                    {% if current %}<span class="badge">cette semaine</span>{% endif %}
                    <span class="plan-week-volume">{{ week.volumeKm|number_format(1, ',') }} km</span>
                </summary>
                <p class="card-subtitle">{{ week.phase.purpose }}</p>
                {% if loop.first %}
                    <p class="card-subtitle">Réalisé : {{ review.currentWeek.doneKm|number_format(1, ',') }} km sur {{ week.volumeKm|number_format(1, ',') }} prévus.</p>
                    {{ include('plan/_week_review.html.twig', {review: review.currentWeek, movable: movable, week_id: week_id, session_types: session_types, token: week_token}, with_context = false) }}
                {% else %}
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th scope="col">Jour</th>
                                <th scope="col">Séance</th>
                                <th scope="col">Contenu</th>
                                <th scope="col" class="num">Distance</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for weekday in 1..7 %}
                                {% set session = week.sessionOn(weekday) %}
                                {% set day = week.monday.modify('+' ~ (weekday - 1) ~ ' days') %}
                                {% if session %}
                                    <tr {{ plan_macros.day_attributes(weekday, weekday in movable) }}>
                                        <td {{ plan_macros.handle_attributes(weekday in movable) }}>{{ weekdays[weekday - 1] }} {{ day|date('d/m') }}</td>
                                        <td>{{ session.type.label }}{% if session.edited %} <span class="badge">modifiée</span>{% endif %}</td>
                                        <td>
                                            {{ session.description }}
                                            {% if weekday in movable %}
                                                {{ include('plan/_session_edit.html.twig', {week_id: week_id, weekday: weekday, session: session, session_types: session_types, token: week_token}, with_context = false) }}
                                            {% endif %}
                                        </td>
                                        <td class="num">{{ session.distanceKm|number_format(1, ',') }} km</td>
                                    </tr>
                                {% else %}
                                    <tr class="plan-rest" {{ plan_macros.day_attributes(weekday, weekday in movable) }}>
                                        <td>{{ weekdays[weekday - 1] }} {{ day|date('d/m') }}</td>
                                        <td colspan="3" class="muted">Repos</td>
                                    </tr>
                                {% endif %}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% endif %}
                <form method="post" action="{{ path('plan_week', {week: week_id}) }}" class="plan-week-form">
                    <input type="hidden" name="_token" value="{{ week_token }}">
                    <label>Sorties cette semaine
                        <select name="sessions">
                            {% for choice in session_choices %}
                                <option value="{{ choice }}" {% if choice == week.plannedSessions %}selected{% endif %}>{{ choice }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <button type="submit" class="button button-secondary">Ajuster la semaine</button>
                    {% if movable|length > 1 %}
                        {# Sans glisser-déposer (clavier, sans JS) : même échange, au choix des deux jours. #}
                        <span class="plan-swap">
                            <label>Échanger le
                                <select name="from" data-plan-week-target="from">
                                    {% for weekday in movable %}
                                        <option value="{{ weekday }}">{{ weekdays[weekday - 1] }} {{ week.monday.modify('+' ~ (weekday - 1) ~ ' days')|date('d/m') }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <label>et le
                                <select name="to" data-plan-week-target="to">
                                    {% for weekday in movable %}
                                        <option value="{{ weekday }}" {% if loop.index == 2 %}selected{% endif %}>{{ weekdays[weekday - 1] }} {{ week.monday.modify('+' ~ (weekday - 1) ~ ' days')|date('d/m') }}</option>
                                    {% endfor %}
                                </select>
                            </label>
                            <button type="submit" name="action" value="swap" class="button button-secondary" data-plan-week-target="swap">Échanger</button>
                        </span>
                    {% endif %}
                    {% if week.adjusted %}
                        <button type="submit" name="action" value="reset" class="link-button">Revenir au réglage général</button>
                    {% endif %}
                </form>
            </details>
        {% endfor %}
    {% endif %}
{% endblock %}
