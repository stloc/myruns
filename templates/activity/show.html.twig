{% extends 'base.html.twig' %}

{% block title %}{{ activity.name ?: 'Activité' }}{% endblock %}

{% block body %}
    <p class="breadcrumb"><a href="{{ path('activity_index') }}">← Activités</a></p>
    <div class="page-heading">
        <h1>{{ activity.name ?: activity.sport.label }}</h1>
        <span class="muted">{{ activity.sport.label }} · {{ activity.startDate|date('d/m/Y à H:i') }}{% if activity.city is not null %} · {{ activity.city }}{% endif %}</span>
    </div>

    <section class="stat-grid" aria-label="Résumé">
        <div class="stat-tile">
            <span class="stat-label">Distance</span>
            <span class="stat-value">{{ activity.distanceMeters|distance }}</span>
        </div>
        <div class="stat-tile">
            <span class="stat-label">Temps de déplacement</span>
            <span class="stat-value">{{ activity.movingTimeSeconds|duration }}</span>
            <span class="stat-detail">temps total {{ activity.elapsedTimeSeconds|duration }}</span>
        </div>
        {% if activity.sport.isRunning %}
            <div class="stat-tile">
                <span class="stat-label">Allure moyenne</span>
                <span class="stat-value">{{ activity.paceSecondsPerKm|pace }}</span>
            </div>
        {% endif %}
        <div class="stat-tile">
            <span class="stat-label">Fréquence cardiaque</span>
            <span class="stat-value">{{ activity.averageHeartRate is not null ? activity.averageHeartRate|number_format(0) ~ ' bpm' : '–' }}</span>
            <span class="stat-detail">
                max {{ activity.maxHeartRate is not null ? activity.maxHeartRate|number_format(0) : '–' }}
                {%- if activity.sustainedMaxHeartRate is not null %} · tenue 10 s {{ activity.sustainedMaxHeartRate }}{% endif %}
            </span>
        </div>
        <div class="stat-tile">
            <span class="stat-label">Dénivelé positif</span>
            <span class="stat-value">{{ activity.effectiveElevationGain is not null ? activity.effectiveElevationGain|number_format(0, ',', ' ') ~ ' m' : '–' }}</span>
            {% if activity.groundElevationGain is not null %}
                <span class="stat-detail" title="Recalculé sur l'altitude du terrain : IGN en France, Copernicus (Open-Meteo) ailleurs">
                    altitude du terrain
                    {%- if activity.elevationGain is not null %} · enregistré {{ activity.elevationGain|number_format(0, ',', ' ') }} m{% endif %}
                </span>
            {% endif %}
        </div>
    </section>

    {% if session_review %}
        <section class="card">
            <div class="card-heading">
                <h2>Séance du programme</h2>
                <a href="{{ path('plan') }}">Voir le programme</a>
            </div>
            {{ include('plan/_session_card.html.twig', {review: session_review}, with_context = false) }}
        </section>
    {% endif %}

    {% if route_map %}
        <section class="card" aria-labelledby="route-map-title">
            <h2 id="route-map-title">Parcours</h2>
            <p class="card-subtitle">Trace colorée selon {{ activity.sport.isRunning ? 'l\'allure' : 'la vitesse' }}, par tronçons d'environ 100 m (survolez la trace pour la valeur).</p>
            <div class="route-map" data-route-map="{{ route_map.toArray|json_encode }}" role="img" aria-label="Carte du parcours"></div>
            <ul class="route-legend" aria-label="Légende">
                {% for item in route_map.legend %}
                    <li class="route-{{ item.class }}">{{ item.label }}</li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if same_route %}
        {% set gap_class = 'gap-' ~ (same_route.gapToAverage < 0 ? 'faster' : 'slower') %}
        <section class="card" aria-labelledby="same-route-title">
            <h2 id="same-route-title">Même parcours</h2>
            <p class="card-subtitle">
                {{ same_route.count }} sorties sur ce parcours depuis le {{ same_route.first.startDate|date('d/m/Y') }},
                comparées au temps de déplacement (départ, tracé et sens identiques).
            </p>
            <div class="stat-grid">
                <div class="stat-tile">
                    <span class="stat-label">Classement</span>
                    <span class="stat-value">{{ same_route.rank == 1 ? 'Record' : same_route.rank ~ 'ᵉ' }}</span>
                    <span class="stat-detail">sur {{ same_route.count }} sorties</span>
                </div>
                <div class="stat-tile">
                    <span class="stat-label">Meilleur temps</span>
                    <span class="stat-value">{{ same_route.best.movingTimeSeconds|duration }}</span>
                    <span class="stat-detail">
                        {%- if same_route.best is same as(activity) %}cette sortie
                        {%- else %}<a href="{{ path('activity_show', {id: same_route.best.id}) }}">le {{ same_route.best.startDate|date('d/m/Y') }}</a> · {{ same_route.gapToBest|gap }}{% endif -%}
                    </span>
                </div>
                <div class="stat-tile">
                    <span class="stat-label">Moyenne des autres sorties</span>
                    <span class="stat-value">{{ same_route.othersAverageSeconds|duration }}</span>
                    <span class="stat-detail"><span class="{{ gap_class }}">{{ same_route.gapToAverage|gap }}</span>
                        {%- if same_route.othersAverageHeartRate is not null %} · FC moy. {{ same_route.othersAverageHeartRate|number_format(0) }} bpm
                            {%- if activity.averageHeartRate is not null %} (ici {{ activity.averageHeartRate|number_format(0) }}){% endif %}
                        {%- endif -%}
                    </span>
                </div>
                {% if same_route.previous %}
                    <div class="stat-tile">
                        <span class="stat-label">Sortie précédente</span>
                        <span class="stat-value">{{ same_route.previous.movingTimeSeconds|duration }}</span>
                        <span class="stat-detail">
                            <a href="{{ path('activity_show', {id: same_route.previous.id}) }}">le {{ same_route.previous.startDate|date('d/m/Y') }}</a> ·
                            <span class="gap-{{ same_route.gapToPrevious < 0 ? 'faster' : 'slower' }}">{{ same_route.gapToPrevious|gap }}</span>
                        </span>
                    </div>
                {% endif %}
            </div>
            <div class="table-scroll">
                <table class="data-table same-route-table">
                    <thead>
                        <tr>
                            <th scope="col">Date</th>
                            <th scope="col" class="num">Rang</th>
                            <th scope="col">Nom</th>
                            <th scope="col" class="num">Temps</th>
                            <th scope="col" class="num">Écart au record</th>
                            <th scope="col" class="num">{{ activity.sport.isRunning ? 'Allure' : 'Distance' }}</th>
                            <th scope="col" class="num">FC moy.</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in same_route.rows %}
                            <tr{% if row.current %} class="is-current" aria-current="true"{% endif %}>
                                <td>{{ row.activity.startDate|date('d/m/Y') }}</td>
                                <td class="num">{{ row.rank }}</td>
                                <td>{% if row.current %}<strong>Cette sortie</strong>{% else %}<a href="{{ path('activity_show', {id: row.activity.id}) }}">{{ row.activity.name ?: row.activity.sport.label }}</a>{% endif %}</td>
                                <td class="num"><strong>{{ row.activity.movingTimeSeconds|duration }}</strong></td>
                                <td class="num muted">{{ row.gap_to_best|gap }}</td>
                                <td class="num">{{ activity.sport.isRunning ? row.activity.paceSecondsPerKm|pace : row.activity.distanceMeters|distance }}</td>
                                <td class="num">{{ row.activity.averageHeartRate is not null ? row.activity.averageHeartRate|number_format(0) : '–' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if same_route.count > same_route.rows|length %}
                <p class="muted">Les {{ constant('App\\Route\\RouteComparison::MAX_ROWS') }} sorties les plus récentes sur {{ same_route.count }}.</p>
            {% endif %}
        </section>
    {% endif %}

    {% if laps %}
        <section class="card">
            <h2>Tours de la montre</h2>
            <p class="card-subtitle">Tours enregistrés pendant la séance (touche Lap ou séance programmée).</p>
            {{ include('activity/_split_table.html.twig', {table: laps, label: 'Tour'}, with_context = false) }}
        </section>
    {% endif %}

    <section class="card">
        <h2>Temps de passage au kilomètre</h2>
        {% if kilometers.rows is empty %}
            <p class="muted">Pas de trace GPS ou de capteur de distance pour cette activité : importez l'archive Strava complète (fichiers .fit / .gpx) pour obtenir les temps de passage.</p>
        {% else %}
            <p class="card-subtitle">
                Temps de déplacement (arrêts exclus).
                {%- if kilometers.rows|filter(r => r.fast)|length > 0 %} Les kilomètres <span class="badge">rapide</span> sont au moins 8 % plus rapides que l'allure médiane.{% endif %}
                {%- if automatic_laps %} Les tours de la montre correspondent à ces kilomètres.{% endif %}
            </p>
            {{ include('activity/_split_table.html.twig', {table: kilometers, label: 'Km'}, with_context = false) }}
        {% endif %}
    </section>
{% endblock %}
