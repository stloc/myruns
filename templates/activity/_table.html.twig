{% if activities is empty %}
    <p class="muted">Aucune activité.</p>
{% else %}
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Type</th>
                    <th scope="col">Nom</th>
                    <th scope="col">Ville</th>
                    <th scope="col" class="num">Distance</th>
                    <th scope="col" class="num">Durée</th>
                    <th scope="col" class="num">Allure</th>
                    <th scope="col" class="num">D+</th>
                    <th scope="col" class="num">FC moy.</th>
                </tr>
            </thead>
            <tbody>
                {% for activity in activities %}
                    <tr>
                        <td>{{ activity.startDate|date('d/m/Y H:i') }}</td>
                        <td>{{ activity.sport.label }}</td>
                        <td><a href="{{ path('activity_show', {id: activity.id}) }}">{{ activity.name ?: activity.sport.label }}</a>{% if activity.hasSplits %} <span class="muted" title="Temps de passage disponibles">⏱</span>{% endif %}</td>
                        <td>{{ activity.city ?? '–' }}</td>
                        <td class="num">{{ activity.distanceMeters|distance }}</td>
                        <td class="num">{{ activity.movingTimeSeconds|duration }}</td>
                        <td class="num">{{ activity.sport.isRunning ? activity.paceSecondsPerKm|pace : '–' }}</td>
                        <td class="num">{{ activity.effectiveElevationGain is not null ? activity.effectiveElevationGain|number_format(0, ',', ' ') ~ ' m' : '–' }}</td>
                        <td class="num">{{ activity.averageHeartRate is not null ? activity.averageHeartRate|number_format(0) : '–' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
