<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
        <title>{% block title %}Tableau de bord{% endblock %} · MyRuns</title>
        <link rel="icon" type="image/svg+xml" href="{{ asset('images/logo.svg') }}">
        <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
        {% block head %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="site-header">
            <a class="brand" href="{{ path('dashboard') }}"><img src="{{ asset('images/logo.svg') }}" alt="" width="28" height="28">MyRuns</a>
            <nav aria-label="Navigation principale">
                {% set route = app.request.attributes.get('_route') %}
                {% for item in [
                    {route: 'dashboard', label: 'Tableau de bord'},
                    {route: 'activity_index', label: 'Activités'},
                    {route: 'goal', label: 'Objectif'},
                    {route: 'plan', label: 'Programme'},
                    {route: 'import', label: 'Import'},
                    {route: 'profile', label: 'Profil'},
                    {route: 'settings', label: 'Réglages'},
                ] %}
                    <a href="{{ path(item.route) }}" {% if route == item.route %}aria-current="page"{% endif %}>{{ item.label }}</a>
                {% endfor %}
            </nav>
            {% if app_version %}<span class="app-version" title="Version de l'application">v{{ app_version }}</span>{% endif %}
        </header>

        <main class="page">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
